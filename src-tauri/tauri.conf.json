{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Administrativo",
  "version": "0.1.0",
  "identifier": "com.mariat.administrativo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Administrativo",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' https://*.turso.io wss://*.turso.io; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzOTkwRTU3NEQ2QTcwODEKUldTQmNHcE5WdzZaNDc5WVM1WW8zM2JzQ0gvQWFFQ1hrMjRVQUh5ZG1yUXVrbzMzUXZ0dzdiakcK",
      "endpoints": [
        "https://clio-update-api.erosbonoladev.workers.dev/updates/administrativo/latest"
      ]
    }
  }
}
